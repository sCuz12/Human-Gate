FROM golang:1.25-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY apps ./apps
COPY db ./db
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/greenpost-worker ./apps/worker

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/greenpost-worker /greenpost-worker

ENTRYPOINT ["/greenpost-worker"]
